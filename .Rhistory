geom_line(data = STXtemppointslimit, aes(x = x, y = y, linetype = '9 Degree Limit'), group = 1) +
scale_linetype_manual(values = c(2, 1),
name = "Average Yearly Temp (C)") +
labs(title = "STX sites that have RHMA")
