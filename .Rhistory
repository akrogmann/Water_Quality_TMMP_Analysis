VItemppoints <- data.frame(
x = c(2022, 2023, 2024),
y = c(26.54425, 26.46213, 30.20092)
)
VItemppointslimits <- data.frame(
x = c(2022, 2023, 2024),
y = c(35.45459, 35.42533, 39.20092)
)
RHMAwq<-wqclassification%>%
filter(Site %in% RHMA$Site)
RHMAwq<-RHMAwq%>%
mutate(
Syringe_used=recode(Syringe_used,
"N"="No",
"Y"="Yes",
"no"="No",
"yes"="Yes",
"n"="No")
)%>%
filter(nzchar(as.character(Syringe_used)))
RHMAwq<-RHMAwq%>%
mutate(Syringe_used=replace_na(Syringe_used, "Unknown"))
RHMAwq$Syringe_used<-as.factor(RHMAwq$Syringe_used)
RHMAwq$SY<-as.factor(RHMAwq$SY)
unique(RHMAwq$Syringe_used)
unique(RHMAwq$Site)
ggplot(data = RHMAwq) +
geom_boxplot(aes(x = SY, y = Temp, Fill = Site, color = Site)) +
geom_point(aes(x = SY, y = Temp, group = Site, fill = Site, , shape = Syringe_used), position = position_dodge(width = 0.75), size = 1.2) +
geom_line(data = VItemppoints, aes(x = x, y = y, linetype = 'NOAA Data'), group = 1) +
geom_line(data = VItemppointslimit, aes(x = x, y = y, linetype = '9 Degree Limit'), group = 1) +
scale_linetype_manual(values = c(2, 1),
name = "Average Yearly Temp (C)") +
labs(title = "All sites that have RHMA")
